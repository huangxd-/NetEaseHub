{
  "name": "neteasehub",
  "version": "0.1.0",
  "description": "网易云音乐云盘上传中心",
  "main": "./out/main/index.js",
  "author": "huangxd",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "install-electron",
    "test:e2e": "playwright test",
    "smoke:providers": "node scripts/provider-smoke.mjs",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
    "pack:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish always",
    "dist:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "4.41.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.11",
    "jsonrepair": "^3.13.1",
    "lucide-react": "^0.468.0",
    "music-metadata": "^12.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "42.11.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.0.9"
  },
  "build": {
    "appId": "com.huangxd.neteasehub",
    "productName": "NetEaseHub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@neteasecloudmusicapienhanced/api/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "NetEaseHub ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "NetEaseHub-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "huangxd-",
      "repo": "NetEaseHub"
    }
  }
}
